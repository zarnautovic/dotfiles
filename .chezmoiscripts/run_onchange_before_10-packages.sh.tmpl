#!/usr/bin/env bash
# Install packages for the Arch + Hyprland + Noctalia desktop.
# Runs on `chezmoi apply` whenever this file changes. Linux only.
# Idempotent: pacman/yay `--needed` skip already-installed packages.
{{- if eq .chezmoi.os "linux" }}
set -euo pipefail

echo "==> Installing repo packages (pacman)…"
sudo pacman -S --needed --noconfirm \
  base-devel git \
  zsh chezmoi starship mise zoxide fzf bat eza tmux neovim gum chafa bc btop \
  lazygit lazydocker \
  docker docker-compose docker-buildx \
  ghostty \
  sddm qt6-svg qt6-5compat qt6-declarative \
  hyprland uwsm \
  hypridle hyprpolkitagent xdg-desktop-portal-hyprland xdg-desktop-portal-gtk \
  hyprshot cliphist wl-clipboard playerctl brightnessctl \
  thunar gnome-keyring \
  networkmanager pipewire pipewire-pulse wireplumber

echo "==> Enabling NetworkManager (networking on boot)…"
sudo systemctl enable NetworkManager.service   # enable only; doesn't disturb the current connection

echo "==> Docker: enabling the daemon + adding you to the docker group…"
sudo systemctl enable docker.service                 # enable only; starts on next boot (use --now to start now)
sudo usermod -aG docker "{{ .chezmoi.username }}"     # run docker without sudo — re-login for it to take effect
# NOTE: membership in 'docker' grants effectively-root access to the host (the daemon runs as root).

# Ensure an AUR helper exists (build yay from the AUR if missing).
if ! command -v yay >/dev/null 2>&1; then
  echo "==> Bootstrapping yay (AUR helper)…"
  tmp="$(mktemp -d)"
  git clone --depth=1 https://aur.archlinux.org/yay.git "$tmp/yay"
  ( cd "$tmp/yay" && makepkg -si --noconfirm )
  rm -rf "$tmp"
fi

echo "==> Installing AUR packages (yay)…"
# noctalia-shell ships its own Quickshell build (noctalia-qs), which conflicts
# with and replaces the official `quickshell` package — so we do NOT install
# `quickshell` above. --ask answers the replace-conflict prompt automatically.
yay -S --needed --noconfirm --ask 4 noctalia-shell

# tmux plugins (tpm + the @plugin bundles in tmux.conf). These live under
# ~/.config/tmux/plugins and are NOT tracked by chezmoi, so bootstrap them here.
TPM_DIR="$HOME/.config/tmux/plugins/tpm"
if [[ ! -d "$TPM_DIR" ]]; then
  echo "==> Bootstrapping tmux plugin manager (tpm)…"
  git clone --depth=1 https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi
if command -v tmux >/dev/null 2>&1; then
  echo "==> Installing tmux plugins…"
  # install_plugins reads the @plugin options, so a server must have sourced tmux.conf first.
  tmux new-session -d -s _tpm_bootstrap 2>/dev/null || true
  "$TPM_DIR/bin/install_plugins" || true
  tmux kill-session -t _tpm_bootstrap 2>/dev/null || true
fi

echo "==> Package install complete."
{{- else }}
exit 0
{{- end }}
