#!/usr/bin/env bash
# Install the Noctalia SDDM theme + config, then enable SDDM as the login manager.
# Linux only. Assumes a clean Arch install (no other display manager to preserve).
# `enable` only — never `enable --now`, which would start SDDM and kill your
# current session. SDDM takes over on the next reboot.
{{- if eq .chezmoi.os "linux" }}
set -euo pipefail

THEME_REPO="https://github.com/mahaveergurjar/sddm.git"
THEME_BRANCH="noctalia"
THEME_DEST="/usr/share/sddm/themes/noctalia"

echo "==> Installing Noctalia SDDM theme to ${THEME_DEST}…"
tmp="$(mktemp -d)"
git clone --depth=1 -b "$THEME_BRANCH" "$THEME_REPO" "$tmp/theme"
rm -rf "$tmp/theme/.git" "$tmp/theme/README.md"
sudo rm -rf "$THEME_DEST"
sudo mkdir -p "$(dirname "$THEME_DEST")"
sudo cp -r "$tmp/theme" "$THEME_DEST"
rm -rf "$tmp"

echo "==> Writing /etc/sddm.conf.d/10-noctalia.conf…"
sudo mkdir -p /etc/sddm.conf.d
sudo tee /etc/sddm.conf.d/10-noctalia.conf >/dev/null <<'EOF'
[Theme]
Current=noctalia

[General]
# Wayland greeter
GreeterEnvironment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1
EOF

echo "==> Enabling SDDM as the login manager (takes effect next boot)…"
sudo systemctl enable sddm.service

cat <<'NEXT'

==> SDDM installed, themed, and enabled.
    Reboot, then pick the "Hyprland (uwsm)" session at the SDDM login screen.
    (Keep a TTY handy the first time: Ctrl+Alt+F3.)
NEXT
{{- else }}
exit 0
{{- end }}
