#!/usr/bin/env bash
# Build the pinned SbarLua revision on macOS; rebuild when the revision changes.
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail
SBARLUA_REF=dba9cc421b868c918d5c23c408544a28aadf2f2f
install_dir="$HOME/.local/share/sketchybar_lua"
stamp="$install_dir/.chezmoi-revision"

command -v lua >/dev/null 2>&1 || brew install lua
xcode-select -p >/dev/null 2>&1

installed_ref=""
if [ -f "$stamp" ]; then
  installed_ref="$(cat "$stamp")"
fi
if [ ! -f "$install_dir/sketchybar.so" ] || [ "$installed_ref" != "$SBARLUA_REF" ]; then
  echo "==> Building SbarLua $SBARLUA_REF…"
  build_dir="$(mktemp -d)"
  trap 'rm -rf "$build_dir"' EXIT
  git -C "$build_dir" init -q
  git -C "$build_dir" fetch --depth=1 https://github.com/FelixKratz/SbarLua.git "$SBARLUA_REF"
  git -C "$build_dir" checkout --detach FETCH_HEAD
  make -C "$build_dir"
  LUA_CPATH="$build_dir/bin/?.so;;" lua -e 'assert(require("sketchybar"))'
  make -C "$build_dir" install
  printf '%s\n' "$SBARLUA_REF" > "$stamp"
  sketchybar --reload
fi
{{- else }}
exit 0
{{- end }}
