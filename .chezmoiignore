# --- OS gating ------------------------------------------------------------
# Linux-only desktop configs: ignored everywhere except Linux.
{{- if ne .chezmoi.os "linux" }}
.config/hypr
.config/noctalia
{{- end }}

# macOS-only: the Brewfile is for `brew bundle` on darwin; not wanted on Linux.
# AeroSpace (tiling WM) and SketchyBar (menu bar) are macOS-only tools.
{{- if ne .chezmoi.os "darwin" }}
Brewfile
.config/aerospace
.config/sketchybar
{{- end }}

# On Linux, starship.toml is owned by Noctalia App Theming (it injects the color
# palette inline, so chezmoi would fight it). Let Noctalia manage the live file
# there — change it via Noctalia's settings. Still tracked/deployed on macOS.
{{- if eq .chezmoi.os "linux" }}
.config/starship.toml
{{- end }}
